{
  "name": "@sarv-in/mailguard",
  "version": "0.4.3",
  "description": "Explainable spam and phishing signals for email, computed offline from the message itself. Reads SPF/DKIM/DMARC results, sender-domain spoofing and the true origin IP out of the headers, and returns a score with human-readable reasons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarv/mailguard.git"
  },
  "homepage": "https://github.com/Sarv/mailguard#readme",
  "bugs": {
    "url": "https://github.com/Sarv/mailguard/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./verdict": {
      "import": {
        "types": "./dist/verdict.d.ts",
        "default": "./dist/verdict.js"
      },
      "require": {
        "types": "./dist/verdict.d.cts",
        "default": "./dist/verdict.cjs"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      },
      "require": {
        "types": "./dist/identity.d.cts",
        "default": "./dist/identity.cjs"
      }
    },
    "./headers": {
      "import": {
        "types": "./dist/headers.d.ts",
        "default": "./dist/headers.js"
      },
      "require": {
        "types": "./dist/headers.d.cts",
        "default": "./dist/headers.cjs"
      }
    },
    "./links": {
      "import": {
        "types": "./dist/links.d.ts",
        "default": "./dist/links.js"
      },
      "require": {
        "types": "./dist/links.d.cts",
        "default": "./dist/links.cjs"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security.d.ts",
        "default": "./dist/security.js"
      },
      "require": {
        "types": "./dist/security.d.cts",
        "default": "./dist/security.cjs"
      }
    },
    "./attachments": {
      "import": {
        "types": "./dist/attachments.d.ts",
        "default": "./dist/attachments.js"
      },
      "require": {
        "types": "./dist/attachments.d.cts",
        "default": "./dist/attachments.cjs"
      }
    },
    "./content": {
      "import": {
        "types": "./dist/content.d.ts",
        "default": "./dist/content.js"
      },
      "require": {
        "types": "./dist/content.d.cts",
        "default": "./dist/content.cjs"
      }
    },
    "./quote": {
      "import": {
        "types": "./dist/quote.d.ts",
        "default": "./dist/quote.js"
      },
      "require": {
        "types": "./dist/quote.d.cts",
        "default": "./dist/quote.cjs"
      }
    },
    "./scan": {
      "import": {
        "types": "./dist/scan.d.ts",
        "default": "./dist/scan.js"
      },
      "require": {
        "types": "./dist/scan.d.cts",
        "default": "./dist/scan.cjs"
      }
    },
    "./verify": {
      "import": {
        "types": "./dist/verify.d.ts",
        "default": "./dist/verify.js"
      },
      "require": {
        "types": "./dist/verify.d.cts",
        "default": "./dist/verify.cjs"
      }
    },
    "./reputation": {
      "import": {
        "types": "./dist/reputation.d.ts",
        "default": "./dist/reputation.js"
      },
      "require": {
        "types": "./dist/reputation.d.cts",
        "default": "./dist/reputation.cjs"
      }
    },
    "./brand": {
      "import": {
        "types": "./dist/brand.d.ts",
        "default": "./dist/brand.js"
      },
      "require": {
        "types": "./dist/brand.d.cts",
        "default": "./dist/brand.cjs"
      }
    },
    "./age": {
      "import": {
        "types": "./dist/age.d.ts",
        "default": "./dist/age.js"
      },
      "require": {
        "types": "./dist/age.d.cts",
        "default": "./dist/age.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm run test:coverage",
    "verify:brands": "pnpm run build && node scripts/verify-brands.mjs --resolver 1.1.1.1",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "spam",
    "spam-filter",
    "phishing",
    "email",
    "email-security",
    "spf",
    "dkim",
    "dmarc",
    "authentication-results",
    "imap",
    "mail",
    "anti-spam"
  ],
  "peerDependencies": {
    "@peculiar/x509": "^2.1.0",
    "asn1js": "^3.0.6",
    "mailauth": "^5.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "@peculiar/x509": {
      "optional": true
    },
    "asn1js": {
      "optional": true
    },
    "mailauth": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "dependencies": {
    "email-addresses": "^5.0.0",
    "htmlparser2": "^10.1.0",
    "ipaddr.js": "^2.2.0",
    "postal-mime": "^3.0.0",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@peculiar/x509": "^2.1.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "asn1js": "^3.0.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-regexp": "^3.3.0",
    "globals": "^17.12.0",
    "mailauth": "^5.0.3",
    "prettier": "^3",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8",
    "vitest": "^1.2.0"
  }
}
